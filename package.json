{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "description": "Distributed Wagering Processor for iGaming Technical Challenge",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run src/main.ts",
    "start:dev": "bun --watch src/main.ts",
    "test": "bun test",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun run scripts/test-integration.ts",
    "test:concurrency": "bun test tests/concurrency",
    "test:load": "bun run scripts/load-test.ts",
    "typecheck": "tsc --noEmit",
    "migration:up": "bun run scripts/migrate.ts",
    "migration:create": "mikro-orm migration:create"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.758.0",
    "@mikro-orm/core": "^6.4.8",
    "@mikro-orm/migrations": "^6.4.8",
    "@mikro-orm/nestjs": "^6.1.1",
    "@mikro-orm/postgresql": "^6.4.8",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.5.0",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.4.8",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.11.11",
    "bun-types": "^1.2.4",
    "typescript": "^5.8.2"
  }
}
